# EXAMPLE ONLY. Not installed on Lighthouse.
# Review paths and user policies before deployment.
[Unit]
Description=Lemonade Stand V2 MCP Server (private localhost)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lemonade-stand-mcp
ExecStart=/usr/bin/node /opt/lemonade-stand-mcp/server-v2.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8044
Environment=MCP_PATH=/mcp
Environment=LEMONADE_DB_PATH=/var/lib/lemonade-stand/save.sqlite
DynamicUser=yes
StateDirectory=lemonade-stand
UMask=0077
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
